# Copie para .env.web.local APENAS no servidor/PC; prepare_web gera chave automaticamente.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_PRODUCTION=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Opcional em produção: caminhos absolutos privados para sessões e assets publicados.
# DJANGO_DATABASE_PATH=/var/lib/smart-environment/web.sqlite3
# DJANGO_STATIC_ROOT=/var/lib/smart-environment/static
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ORGANIZATION_ID=
PROCESSING_SERVER_URL=
LOCAL_MONITOR_ENABLED=false
