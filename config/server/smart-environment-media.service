[Unit]
Description=Smart Environment private MediaMTX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smart-environment
WorkingDirectory=/opt/smart-environment
ExecStart=/opt/smart-environment/tools/streaming/1.20.1/mediamtx /etc/smart-environment/mediamtx.yml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
