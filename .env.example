# Copie para .env somente no ambiente local. O aplicativo ainda não carrega .env
# automaticamente; a integração será adicionada na fase de configuração/banco.
MULTICAM_ENV=development
MULTICAM_LOG_LEVEL=INFO
MULTICAM_DATA_DIR=data
MULTICAM_RECOGNITION_DEVICE=auto
MULTICAM_OFFLINE_MODE=true
MULTICAM_MAX_CAMERAS=1

# Fase 2+: injete a senha por secret manager/ambiente e mantenha .env fora do Git.
MULTICAM_DATABASE_URL=postgresql+psycopg://localhost:5432/multicam
MULTICAM_DATABASE_USER=multicam
MULTICAM_DATABASE_PASSWORD=
MULTICAM_JWT_SECRET=
MULTICAM_SERVER_URL=https://localhost:8443
